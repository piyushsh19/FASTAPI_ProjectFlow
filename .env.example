
# Application
APP_NAME=ProjectFlow API
APP_VERSION=0.1.0
DEBUG=true
ENVIRONMENT=development

# PostgreSQL
DATABASE_URL=postgresql+psycopg://projectflow_user:replace-me@localhost:5433/projectflow_db
TEST_DATABASE_URL=postgresql+psycopg://projectflow_user:replace-me@localhost:5433/projectflow_test_db

# JWT Authentication
SECRET_KEY=replace-with-a-secure-random-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Redis
REDIS_URL=redis://localhost:6379/0

# Logging
LOG_LEVEL=DEBUG

# CORS
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Docker PostgreSQL container
POSTGRES_USER=projectflow_user
POSTGRES_PASSWORD=replace-with-local-database-password
POSTGRES_DB=projectflow_db
